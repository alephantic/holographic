# Copy to .env (never commit .env). The server reads this file at startup.
# Chat mode needs ONE server-side model key. Saving works without any key.
# The server uses OpenAI when OPENAI_API_KEY is set, otherwise Anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: model used for Chat. Defaults to gpt-5 (OpenAI) or claude-opus-5-5 (Anthropic).
HOLOGRAPHIC_MODEL=
# Optional but recommended on a public deployment: a shared access key. When set,
# Chat requests must present it (the interface asks once). Save never needs it.
HOLOGRAPHIC_ACCESS_KEY=
# Optional: PostgreSQL connection string for shared "studio" storage, used by the
# :neon scripts and in production. `npm run dev` and the plain db:* scripts always
# use the local Docker database (npm run db:up) and ignore this value. A hosted
# database usually needs ?sslmode=require; `neon deploy` fills these in.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: server port. Defaults to 8787.
PORT=8787
